{
  "rewrites": [
    {
      "source": "/i/:token",
      "destination": "/index.html"
    },
    {
      "source": "/d/:token",
      "destination": "/index.html"
    },
    {
      "source": "/traiteurs",
      "destination": "/index.html"
    },
    {
      "source": "/t/:slug",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "media-*": false,
      "tmp*": false,
      "temp*": false
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}